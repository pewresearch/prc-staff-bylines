{
	"name": "prc/staff-bylines",
	"description": "Staff profile and byline management system for the PRC Platform. Links a `staff` post type to a `bylines` taxonomy via prc/term-data-store.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2",
		"automattic/jetpack-autoloader": "^5.0",
		"prc/block-utils": "^1.1",
		"prc/term-data-store": "^1.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0.0"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"automattic/jetpack-autoloader": true
		},
		"github-protocols": [
			"https"
		],
		"platform": {
			"php": "8.4.0"
		}
	},
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/pewresearch/term-data-store"
		},
		{
			"type": "vcs",
			"url": "https://github.com/pewresearch/prc-block-utils"
		}
	]
}
